-                            className="w-full bg-ceylon-green hover:bg-ceylon-green-dark text-white"
+                            className="w-full bg-ceylon-green hover:bg-ceylon-green/90 text-white"
                             onClick={async () => {
                               try {
                                 // Update profile with the previewed avatar
@@ -975,138 +975,6 @@ function ProfileEditor({ profile, onUpdate }: any) {

                       <div className="text-center mb-6">
                         <Button
                           type="button"
-                          className="w-full bg-ceylon-green hover:bg-ceylon-green-dark text-white"
+                          className="w-full bg-ceylon-green hover:bg-ceylon-green/90 text-white"
                           onClick={() => {
                             // Generate random avatar within selected style for preview
                             const randomSeed = Math.random().toString(36).substring(7);
@@ -838,7 +838,7 @@ function ProfileEditor({ profile, onUpdate }: any) {

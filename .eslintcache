aims?.sub);\n        if (user?.claims?.sub) {\n          const userId = user.claims.sub;\n          const userData = await storage.getUser(userId);\n          if (userData) {\n            console.log(\"✅ User authenticated via Replit Auth:\", userData.email);\n            return res.json(userData);\n          } \n            console.log(\"⚠️ Replit Auth user ID found but no database record:\", userId);\n          \n        }\n      } else {\n        console.log(\"🔍 req.isAuthenticated() returned:\", req.isAuthenticated ? req.isAuthenticated() : 'not a function');\n      }\n      \n      // No authentication found\n      console.log(\"❌ No authentication method worked\");\n      return res.status(401).json({ message: \"Unauthorized\" });\n    } catch (error) {\n      console.error(\"❌ Error in /api/auth/me:\", error);\n      res.status(500).json({ message: \"Failed to fetch user\" });\n    }\n  }",{"fix":"10474","messageId":"10113","data":"10475","desc":"10209"},{"fix":"10476","messageId":"10113","data":"10477","desc":"10209"},{"fix":"10478","messageId":"10113","data":"10479","desc":"10209"},{"fix":"10480","messageId":"10113","data":"10481","desc":"10139"},{"messageId":"10131","fix":"10482","desc":"10133"},{"messageId":"10134","fix":"10483","desc":"10136"},{"fix":"10484","messageId":"10113","data":"10485","desc":"10209"},[7599,7606],{"messageId":"10131","fix":"10486","desc":"10133"},{"messageId":"10134","fix":"10487","desc":"10136"},{"fix":"10488","messageId":"10113","data":"10489","desc":"10209"},{"fix":"10490","messageId":"10113","data":"10491","desc":"10209"},{"fix":"10492","messageId":"10113","data":"10493","desc":"10139"},{"messageId":"10131","fix":"10494","desc":"10133"},{"messageId":"10134","fix":"10495","desc":"10136"},{"messageId":"10118","data":"10496","fix":"10497","desc":"10498"},{"messageId":"10118","data":"10499","fix":"10500","desc":"10498"},{"messageId":"10142","fix":"10501","desc":"10144"},{"messageId":"10142","fix":"10502","desc":"10144"},{"fix":"10
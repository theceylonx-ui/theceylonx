         `\n        })\n        .from(trips)\n        .where(and(\n          eq(trips.status, 'active'),\n          gte(trips.departureDate, new Date().toISOString()),\n          gte(trips.availableSpots, 1),\n          viewedTripIds.length > 0 ? sql`${trips.id} NOT IN (${viewedTripIds.join(',')})` : sql`1=1`\n        ))\n        .orderBy(desc(sql`score`), desc(trips.createdAt))\n        .limit(limit);",{"messageId":"10131","fix":"10543","desc":"10133"},{"messageId":"10134","fix":"10544","desc":"10136"},{"messageId":"10118","data":"10545","fix":"10546","desc":"10547"},{"messageId":"10131","fix":"10548","desc":"10133"},{"messageId":"10134","fix":"10549","desc":"10136"},[1815,1822],{"messageId":"10131","fix":"10550","desc":"10133"},{"messageId":"10134","fix":"10551","desc":"10136"},[2974,2997],"{hitRate} = stats",{"messageId":"10118","data":"10552","fix":"10553","desc":"10554"},{"messageId":"10118","data":"10555","fix":"10556","desc":"10557"},{"messageId":"10118","data":"10558","fix":"10559","desc":"10560"},{"messageId":"10142","fix":"10561","desc":"10144"},{"messageId":"10118","data":"10562","fix":"10563","desc":"10564"},{"messageId":"10118","data":"10565","fix":"10566","desc":"10557"},{"messageId":"10118","data":"10567","fix":"10568","desc":"10569"},{"fix":"10570","messageId":"10113","data":"10571","desc":"10139"},{"messageId":"10142","fix":"10572","desc":"10144"},{"fix":"10573","messageId":"10113","data":"10574","desc":"10209"},{"fix":"10575","messageId":"10113","data":"10576","desc":"10209"},{"fix":"10577","messageId":"10113","data":"10578","desc":"10209"},{"fix":"10579","messageId":"10113","data":"10580","desc":"10115"},{"messageId":"10118","data":"10581","fix":"10582","desc":"10583"},{"messageId":"10118","data":"10584","fix":"10585","desc":"10586"},{"messageId":"10118","data":"10587","fix":"10588","desc":"10589"},{"messageId":"10118","data":"10590","fix":"10591","desc":"10592"},{"messageId":"10118","data":"10593","fix":"10594","desc":"10595"},{"messageId":"10118
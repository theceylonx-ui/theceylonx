dateUpvoteScore(itemType, itemId, newScore);\n      const item = await this.getItemWithScore(itemType, itemId);\n      return { hasUpvoted: false, newScore, item };\n    } \n      // Add upvote\n      await this.addUpvote(userId, itemType, itemId);\n      const newScore = await this.calculateUpvoteScore(itemType, itemId);\n      await this.updateUpvoteScore(itemType, itemId, newScore);\n      const item = await this.getItemWithScore(itemType, itemId);\n      return { hasUpvoted: true, newScore, item };\n    \n  }",[55260,55919],"(userId: string, questionId: string): Promise<boolean> {\n    const existing = await db\n      .select()\n      .from(questionUpvotes)\n      .where(and(\n        eq(questionUpvotes.userId, userId),\n        eq(questionUpvotes.questionId, questionId)\n      ));\n\n    if (existing.length > 0) {\n      // Remove upvote\n      await db\n        .delete(questionUpvotes)\n        .where(and(\n          eq(questionUpvotes.userId, userId),\n          eq(questionUpvotes.questionId, questionId)\n        ));\n      return false;\n    } \n      // Add upvote\n      await db\n        .insert(questionUpvotes)\n        .values({ userId, questionId });\n      return true;\n    \n  }",[55947,56580],"(userId: string, answerId: string): Promise<boolean> {\n    const existing = await db\n      .select()\n      .from(answerUpvotes)\n      .where(and(\n        eq(answerUpvotes.userId, userId),\n        eq(answerUpvotes.answerId, answerId)\n      ));\n\n    if (existing.length > 0) {\n      // Remove upvote\n      await db\n        .delete(answerUpvotes)\n        .where(and(\n          eq(answerUpvotes.userId, userId),\n          eq(answerUpvotes.answerId, answerId)\n        ));\n      return false;\n    } \n      // Add upvote\n      await db\n        .insert(answerUpvotes)\n        .values({ userId, answerId });\n      return true;\n    \n  }",{"messageId":"10131","fix":"12819","desc":"10133"},{"messageId":"10134","fix":"12820","desc":"10136"},{"messageId":"10131","fix":"12821","desc":"10133"},{"messageId":"10134","fix":"12822","desc":"10136"},[64150,64162],"value",[64174,64198],"description",[64210,64228],"category",[66320,66321],{"messageId":"10131","fix":"12823","desc":"10133"},{"messageId":"10134","fix":"12824","desc":"10136"},{"messageId":"10131","fix":"12825","desc":"10133"},{"messageId":"10134","fix":"12826","desc":"10136"},[67752,67759],{"messageId":"10131","fix":"12827","desc":"10133"},{"messageId":"10134","fix":"12828","desc":"10136"},{"messageId":"10131","fix":"12829","desc":"10133"},{"messageId":"10134","fix":"12830","desc":"10136"},{"messageId":"10131","fix":"12831","desc":"10133"},{"messageId":"10134","fix":"12832","desc":"10136"},[77066,77105],"{chatThreadId} = requestData",{"fix":"12833","messageId":"10113","data":"12834","desc":"10209"},{"fix":"12835","messageId":"10113","data":"12836","desc":"10209"},{"fix":"12837","messageId":"10113","data":"12838","desc":"10209"},{"fix":"12839","messageId":"10113","data":"12840","desc":"10209"},{"fix":"12841","messageId":"10113","data":"12842","desc":"10209"},{"fix":"12843","messageId":"10113","data":"12844","desc":"10209"},{"fix":"12845","messageId":"10113","data":"12846","desc":"10209"},{"fix":"12847","messageId":"10113","data":"12848","desc":"10209"},{"fix":"12849","messageId":"10113","data":"12850","desc":"10209"},{"fix":"12851","messageId":"10113","data":"12852","desc":"10139"},{"fix":"12853","messageId":"10113","data":"12854","desc":"10139"},{"fix":"12855","messageId":"10113","data":"12856","desc":"10139"},{"fix":"12857","messageId":"10113","data":"12858","desc":"10139"},{"messageId":"10131","fix":"12859","desc":"10133"},{"messageId":"10134","fix":"12860","desc":"10136"},{"messageId":"10131","fix":"12861","desc":"10133"},{"messageId":"10134","fix":"12862","desc":"10136"},{"messageId":"10131","fix":"12863","desc":"10133"},{"messageId":"10134","fix":"12864","desc":"10136"},{"messageId":"10131","fix":"12865","desc":"10133"},{"messageId":"10134","fix":"12866","desc":"10136"},{"messageId":"10131","fix":"12867","desc":"10133"},{"messageId":"10134","fix":"12868","desc":"10136"},{"messageId":"10131","fix":"12869","desc":"10133"},{"messageId":"10134","fix":"12870","desc":"10136"},{"messageId":"10131","fix":"12871","desc":"10133"},{"messageId":"10134","fix":"12872","desc":"10136"},{"messageId":"10131","fix":"12873","desc":"10133"},{"messageId":"10134","fix":"12874","desc":"10136"},[92442,92999],"const query = db\n      .select({\n        message: chatMessages,\n        sender: {\n          id: users.id,\n          firstName: users.firstName,\n          lastName: users.lastName,\n          username: users.username,\n          profileImageUrl: users.profileImageUrl\n        }\n      })\n      .from(chatMessages)\n      .leftJoin(users, eq(chatMessages.senderId, users.id))\n      .where(eq(chatMessages.threadId, threadId))\n      .orderBy(asc(chatMessages.createdAt)) // 🔥 CEYLONX CHALLENGE FIX: WhatsApp-style chronological order 🔥\n      .limit(options.limit);",{"messageId":"10131","fix":"12875","desc":"10133"},{"messageId":"10134","fix":"12876","desc":"10136"},{"messageId":"10131","fix":"12877","desc":"10133"},{"messageId":"10134","fix":"12878","desc":"10136"},[94928,95529],"(userId: string, itemType: 'question' | 'answer', itemId: string): Promise<any | undefined> {\n    if (itemType === 'question') {\n      const [upvote] = await db\n        .select()\n        .from(questionUpvotes)\n        .where(and(\n          eq(questionUpvotes.userId, userId),\n          eq(questionUpvotes.questionId, itemId)\n        ));\n      return upvote;\n    } \n      const [upvote] = await db\n        .select()\n        .from(answerUpvotes)\n        .where(and(\n          eq(answerUpvotes.userId, userId),\n          eq(answerUpvotes.answerId, itemId)\n        ));\n      return upvote;\n    \n  }",[96422,96958],"(itemType: 'question' | 'answer', itemId: string): Promise<number> {\n    if (itemType === 'question') {\n      const result = await db\n        .select({ count: sql<number>`count(*)::int` })\n        .from(questionUpvotes)\n        .where(eq(questionUpvotes.questionId, itemId));\n      return result[0]?.count || 0;\n    } \n      const result = await db\n        .select({ count: sql<number>`count(*)::int` })\n        .from(answerUpvotes)\n        .where(eq(answerUpvotes.answerId, itemId));\n      return result[0]?.count || 0;\n    \n  }",{"messageId":"10131","fix":"12879","desc":"10133"},{"messageId":"10134","fix":"12880","desc":"10136"},[97362,97761],"(itemType: 'question' | 'answer', itemId: string): Promise<any> {\n    if (itemType === 'question') {\n      const [question] = await db\n        .select()\n        .from(questions)\n        .where(eq(questions.id, itemId));\n      return question;\n    } \n      const [answer] = await db\n        .select()\n        .from(answers)\n        .where(eq(answers.id, itemId));\n      return answer;\n    \n  }",{"messageId":"10131","fix":"12881","desc":"10133"},{"messageId":"10134","fix":"12882","desc":"10136"},{"messageId":"10131","fix":"12883","desc":"10133"},{"messageId":"10134","fix":"12884","desc":"10136"},{"fix":"12885","messageId":"10113","data":"12886","desc":"10139"},{"fix":"12887","messageId":"10113","data":"12888","desc":"10139"},{"fix":"12889","messageId":"10113","data":"12890","desc":"10139"},{"messageId":"10131","fix":"12891","desc":"10133"},{"messageId":"10134","fix":"12892","desc":"10136"},{"messageId":"10131","fix":"12893","desc":"10133"},{"messageId":"10134","fix":"12894","desc":"10136"},{"messageId":"10131","fix":"12895","desc":"10133"},{"messageId":"10134","fix":"12896","desc":"10136"},{"messageId":"10131","fix":"12897","desc":"10133"},{"messageId":"10134","fix":"12898","desc":"10136"},{"messageId":"10131","fix":"12899","desc":"10133"},{"messageId":"10134","fix":"12900","desc":"10136"},{"messageId":"10131","fix":"12901","desc":"10133"},{"messageId":"10134","fix":"12902","desc":"10136"},{"messageId":"10131","fix":"12903","desc":"10133"},{"messageId":"10134","fix":"12904","desc":"10136"},{"messageId":"10131","fix":"12905","desc":"10133"},{"messageId":"10134","fix":"12906","desc":"10136"},{"messageId":"10131","fix":"12907","desc":"10133"},{"messageId":"10134","fix":"12908","desc":"10136"},{"messageId":"10131","fix":"12909","desc":"10133"},{"messageId":"10134","fix":"12910","desc":"10136"},{"messageId":"10131","fix":"12911","desc":"10133"},{"messageId":"10134","fix":"12912","desc":"10136"},{"messageId":"10131","fix":"12913","desc":"10133"},{"messageId":"10134","fix":"12914","desc":"10136"},[102737,104465],"(userId: string, privacy: any): Promise<any> {\n    const updateData: any = {};\n    \n    if (privacy.visibility !== undefined) updateData.visibility = privacy.visibility;\n    if (privacy.dmPolicy !== undefined) updateData.dmPolicy = privacy.dmPolicy;\n    if (privacy.showOnline !== undefined) updateData.showOnline = privacy.showOnline;\n    if (privacy.showJoinedTrips !== undefined) updateData.showJoinedTrips = privacy.showJoinedTrips;\n    if (privacy.cityVisibility !== undefined) updateData.cityVisibility = privacy.cityVisibility;\n    \n    updateData.updatedAt = new Date();\n\n    // Check if privacy record exists\n    const [existingPrivacy] = await db\n      .select()\n      .from(userPrivacy)\n      .where(eq(userPrivacy.userId, userId));\n\n    if (existingPrivacy) {\n      // Update existing privacy record\n      const [updatedPrivacy] = await db\n        .update(userPrivacy)\n        .set(updateData)\n        .where(eq(userPrivacy.userId, userId))\n        .returning({\n          visibility: userPrivacy.visibility,\n          dmPolicy: userPrivacy.dmPolicy,\n          showOnline: userPrivacy.showOnline,\n          showJoinedTrips: userPrivacy.showJoinedTrips,\n          cityVisibility: userPrivacy.cityVisibility,\n        });\n\n      return updatedPrivacy;\n    } \n      // Create new privacy record\n      const [newPrivacy] = await db\n        .insert(userPrivacy)\n        .values({ userId, ...updateData })\n        .returning({\n          visibility: userPrivacy.visibility,\n          dmPolicy: userPrivacy.dmPolicy,\n          showOnline: userPrivacy.showOnline,\n          showJoinedTrips: userPrivacy.showJoinedTrips,\n          cityVisibility: userPrivacy.cityVisibility,\n        });\n\n      return newPrivacy;\n    \n  }",{"messageId":"10131","fix":"12915","desc":"10133"},{"messageId":"10134","fix":"12916","desc":"10136"},{"fix":"12917","messageId":"10113","data":"12918","desc":"10209"},{"messageId":"10131","fix":"12919","desc":"10133"},{"messageId":"10134","fix":"12920","desc":"10136"},{"messageId":"10131","fix":"12921","desc":"10133"},{"messageId":"10134","fix":"12922","desc":"10136"},{"messageId":"10142","fix":"12923","desc":"10144"},{"messageId":"10131","fix":"12924","desc":"10133"},{"messageId":"10134","fix":"12925","desc":"10136"},{"messageId":"10142","fix":"12926","desc":"10144"},{"messageId":"10118","data":"12927","fix":"12928","desc":"12677"},{"messageId":"10131","fix":"12929","desc":"10133"},{"messageId":"10134","fix":"12930","desc":"10136"},{"messageId":"10131","fix":"12931","desc":"10133"},{"messageId":"10134","fix":"12932","desc":"10136"},{"messageId":"10142","fix":"12933","desc":"10144"},{"messageId":"10131","fix":"12934","desc":"10133"},{"messageId":"10134","fix":"12935","desc":"10136"},{"messageId":"10142","fix":"12936","desc":"10144"},{"messageId":"10118","data":"12937","fix":"12938","desc":"11328"},{"messageId":"10131","fix":"12939","desc":"10133"},{"messageId":"10134","fix":"12940","desc":"10136"},{"messageId":"10131","fix":"12941","desc":"10133"},{"messageId":"10134","fix":"12942","desc":"10136"},[1144,1166],"`${pub.slice(0, 10)  }…`",[1199,1221],"`${sec.slice(0, 10)  }…`",[536,564],"`+94${  cleaned.substring(1)}`",[650,663],[771,786],"`+94${  cleaned}`",{"messageId":"10131","fix":"12943","desc":"10133"},{"messageId":"10134","fix":"12944","desc":"10136"},{"messageId":"10131","fix":"12945","desc":"10133"},{"messageId":"10134","fix":"12946","desc":"10136"},{"messageId":"11870","fix":"12947","desc":"11872"},{"messageId":"10131","fix":"12948","desc":"10133"},{"messageId":"10134","fix":"12949","desc":"10136"},{"messageId":"10131","fix":"12950","desc":"10133"},{"messageId":"10134","fix":"12951","desc":"10136"},{"messageId":"10131","fix":"12952","desc":"10133"},{"messageId":"10134","fix":"12953","desc":"10136"},{"messageId":"10131","fix":"12954","desc":"10133"},{"messageId":"10134","fix":"12955","desc":"10136"},{"messageId":"10118","data":"12956","fix":"12957","desc":"12958"},{"messageId":"10131","fix":"12959","desc":"10133"},{"messageId":"10134","fix":"12960","desc":"10136"},{"messageId":"10131","fix":"12961","desc":"10133"},{"messageId":"10134","fix":"12962","desc":"10136"},{"messageId":"10131","fix":"12963","desc":"10133"},{"messageId":"10134","fix":"12964","desc":"10136"},{"messageId":"10131","fix":"12965","desc":"10133"},{"messageId":"10134","fix":"12966","desc":"10136"},{"fix":"12967","messageId":"10113","data":"12968","desc":"10139"},{"fix":"12969","messageId":"10113","data":"12970","desc":"10115"},{"fix":"12971","messageId":"10113","data":"12972","desc":"10209"},{"messageId":"10131","fix":"12973","desc":"10133"},{"messageId":"10134","fix":"12974","desc":"10136"},{"messageId":"10131","fix":"12975","desc":"10133"},{"messageId":"10134","fix":"12976","desc":"10136"},{"messageId":"10131","fix":"12977","desc":"10133"},{"messageId":"10134","fix":"12978","desc":"10136"},{"messageId":"10131","fix":"12979","desc":"10133"},{"messageId":"10134","fix":"12980","desc":"10136"},{"messageId":"10131","fix":"12981","desc":"10133"},{"messageId":"10134","fix":"12982","desc":"10136"},{"messageId":"10118","data":"12983","fix":"12984","desc":"12985"},{"messageId":"10118","data":"12986","fix":"12987","desc":"11259"},{"messageId":"10118","data":"12988","fix":"12989","desc":"12990"},{"messageId":"10131","fix":"12991","desc":"10133"},{"messageId":"10134","fix":"12992","desc":"10136"},{"fix":"12993","messageId":"10113","data":"12994","desc":"10209"},{"fix":"12995","messageId":"10113","data":"12996","desc":"10209"},{"fix":"12997","messageId":"10113","data":"12998","desc":"10209"},{"fix":"12999","messageId":"10113","data":"13000","desc":"10209"},[1807,6428],"async function withIdempotency<T>(\n  options: IdempotencyOptions,\n  operation: () => Promise<T>\n): Promise<T> {\n  const { key, operationType, userId, requestHash, expiryMinutes = 60 } = options;\n  \n  const expiresAt = new Date(Date.now() + expiryMinutes * 60 * 1000);\n  const { pool } = await import(\"../db\");\n  \n  try {\n    // CRITICAL FIX: Use single atomic operation to check and claim the operation\n    // This prevents race conditions by ensuring only ONE request can proceed\n    const claimQuery = `\n      INSERT INTO idempotency_keys (key, operation_type, user_id, request_hash, status, expires_at)\n      VALUES ($1, $2, $3, $4, 'processing', $5)\n      ON CONFLICT (key) DO NOTHING\n      RETURNING key, status\n    `;\n    \n    const claimResult = await pool.query(claimQuery, [key, operationType, userId, requestHash, expiresAt]);\n    \n    if (claimResult.rows.length > 0) {\n      // SUCCESS: This request successfully claimed the operation - proceed with execution\n      try {\n        console.log(`🔒 Idempotency: Executing operation for key ${key}`);\n        const result = await operation();\n        \n        // Mark as completed with result\n        await pool.query(\n          `UPDATE idempotency_keys \n           SET status = 'completed', response_data = $2, completed_at = NOW() \n           WHERE key = $1`,\n          [key, JSON.stringify(result)]\n        );\n        \n        return result;\n        \n      } catch (operationError) {\n        // Mark as failed if operation throws\n        await pool.query(\n          `UPDATE idempotency_keys SET status = 'failed', completed_at = NOW() WHERE key = $1`,\n          [key]\n        );\n        throw operationError;\n      }\n    } else {\n      // COLLISION: Another request already claimed this operation\n      // Check existing record status and handle accordingly\n      const checkQuery = `\n        SELECT key, status, response_data, created_at\n        FROM idempotency_keys \n        WHERE key = $1 AND expires_at > NOW()\n      `;\n      const existing = await pool.query(checkQuery, [key]);\n      \n      if (existing.rows.length === 0) {\n        // Key expired between insert attempt and check - retry once\n        console.log(`⚡ Idempotency: Key ${key} expired, retrying`);\n        return withIdempotency(options, operation);\n      }\n      \n      const record = existing.rows[0];\n      \n      if (record.status === 'completed') {\n        // Return cached result\n        console.log(`✅ Idempotency: Returning cached result for key ${key}`);\n        return record.response_data as T;\n      } else if (record.status === 'processing') {\n        // Check if it's been processing too long (>5 minutes), then allow retry\n        const processingTime = Date.now() - new Date(record.created_at).getTime();\n        if (processingTime > 5 * 60 * 1000) {\n          console.log(`⏰ Idempotency: Processing timeout for key ${key}, allowing retry`);\n          // Reset to failed status to allow retry\n          await pool.query(\n            `UPDATE idempotency_keys SET status = 'failed', completed_at = NOW() WHERE key = $1`,\n            [key]\n          );\n          // Retry the entire operation\n          return withIdempotency(options, operation);\n        } \n          // Still processing, caller should wait and retry\n          console.log(`⏳ Idempotency: Operation ${key} still processing, rejecting duplicate`);\n          throw new Error('Operation already in progress. Please wait and retry.');\n        \n      } else if (record.status === 'failed') {\n        // Previous attempt failed, allow retry by attempting to claim again\n        console.log(`🔄 Idempotency: Previous attempt failed for key ${key}, allowing retry`);\n        \n        const retryClaimQuery = `\n          UPDATE idempotency_keys \n          SET status = 'processing', created_at = NOW(), completed_at = NULL\n          WHERE key = $1 AND status = 'failed'\n          RETURNING key\n        `;\n        const retryClaim = await pool.query(retryClaimQuery, [key]);\n        \n        if (retryClaim.rows.length > 0) {\n          // Successfully claimed retry\n          return withIdempotency(options, operation);\n        } else {\n          // Another request beat us to the retry\n          throw new Error('Operation retry already in progress. Please wait and retry.');\n        }\n      }\n      \n      throw new Error(`Unknown idempotency status: ${record.status}`);\n    }\n    \n  } catch (error) {\n    // Only mark as failed if we actually claimed the operation\n    // (Don't interfere with other requests' operations)\n    console.error(`❌ Idempotency error for key ${key}:`, error);\n    throw error;\n  }\n}",{"fix":"13001","messageId":"10113","data":"13002","desc":"10209"},{"fix":"13003","messageId":"10113","data":"13004","desc":"10209"},[1807,6428],"async function withIdempotency<T>(\n  options: IdempotencyOptions,\n  operation: () => Promise<T>\n): Promise<T> {\n  const { key, operationType, userId, requestHash, expiryMinutes = 60 } = options;\n  \n  const expiresAt = new Date(Date.now() + expiryMinutes * 60 * 1000);\n  const { pool } = await import(\"../db\");\n  \n  try {\n    // CRITICAL FIX: Use single atomic operation to check and claim the operation\n    // This prevents race conditions by ensuring only ONE request can proceed\n    const claimQuery = `\n      INSERT INTO idempotency_keys (key, operation_type, user_id, request_hash, status, expires_at)\n      VALUES ($1, $2, $3, $4, 'processing', $5)\n      ON CONFLICT (key) DO NOTHING\n      RETURNING key, status\n    `;\n    \n    const claimResult = await pool.query(claimQuery, [key, operationType, userId, requestHash, expiresAt]);\n    \n    if (claimResult.rows.length > 0) {\n      // SUCCESS: This request successfully claimed the operation - proceed with execution\n      try {\n        console.log(`🔒 Idempotency: Executing operation for key ${key}`);\n        const result = await operation();\n        \n        // Mark as completed with result\n        await pool.query(\n          `UPDATE idempotency_keys \n           SET status = 'completed', response_data = $2, completed_at = NOW() \n           WHERE key = $1`,\n          [key, JSON.stringify(result)]\n        );\n        \n        return result;\n        \n      } catch (operationError) {\n        // Mark as failed if operation throws\n        await pool.query(\n          `UPDATE idempotency_keys SET status = 'failed', completed_at = NOW() WHERE key = $1`,\n          [key]\n        );\n        throw operationError;\n      }\n    } else {\n      // COLLISION: Another request already claimed this operation\n      // Check existing record status and handle accordingly\n      const checkQuery = `\n        SELECT key, status, response_data, created_at\n        FROM idempotency_keys \n        WHERE key = $1 AND expires_at > NOW()\n      `;\n      const existing = await pool.query(checkQuery, [key]);\n      \n      if (existing.rows.length === 0) {\n        // Key expired between insert attempt and check - retry once\n        console.log(`⚡ Idempotency: Key ${key} expired, retrying`);\n        return withIdempotency(options, operation);\n      }\n      \n      const record = existing.rows[0];\n      \n      if (record.status === 'completed') {\n        // Return cached result\n        console.log(`✅ Idempotency: Returning cached result for key ${key}`);\n        return record.response_data as T;\n      } else if (record.status === 'processing') {\n        // Check if it's been processing too long (>5 minutes), then allow retry\n        const processingTime = Date.now() - new Date(record.created_at).getTime();\n        if (processingTime > 5 * 60 * 1000) {\n          console.log(`⏰ Idempotency: Processing timeout for key ${key}, allowing retry`);\n          // Reset to failed status to allow retry\n          await pool.query(\n            `UPDATE idempotency_keys SET status = 'failed', completed_at = NOW() WHERE key = $1`,\n            [key]\n          );\n          // Retry the entire operation\n          return withIdempotency(options, operation);\n        } else {\n          // Still processing, caller should wait and retry\n          console.log(`⏳ Idempotency: Operation ${key} still processing, rejecting duplicate`);\n          throw new Error('Operation already in progress. Please wait and retry.');\n        }\n      } else if (record.status === 'failed') {\n        // Previous attempt failed, allow retry by attempting to claim again\n        console.log(`🔄 Idempotency: Previous attempt failed for key ${key}, allowing retry`);\n        \n        const retryClaimQuery = `\n          UPDATE idempotency_keys \n          SET status = 'processing', created_at = NOW(), completed_at = NULL\n          WHERE key = $1 AND status = 'failed'\n          RETURNING key\n        `;\n        const retryClaim = await pool.query(retryClaimQuery, [key]);\n        \n        if (retryClaim.rows.length > 0) {\n          // Successfully claimed retry\n          return withIdempotency(options, operation);\n        } \n          // Another request beat us to the retry\n          throw new Error('Operation retry already in progress. Please wait and retry.');\n        \n      }\n      \n      throw new Error(`Unknown idempotency status: ${record.status}`);\n    }\n    \n  } catch (error) {\n    // Only mark as failed if we actually claimed the operation\n    // (Don't interfere with other requests' operations)\n    console.error(`❌ Idempotency error for key ${key}:`, error);\n    throw error;\n  }\n}",{"fix":"13005","messageId":"10113","data":"13006","desc":"10139"},{"messageId":"10131","fix":"13007","desc":"10133"},{"messageId":"10134","fix":"13008","desc":"10136"},{"fix":"13009","messageId":"10113","data":"13010","desc":"10139"},{"fix":"13011","messageId":"10113","data":"13012","desc":"10209"},{"fix":"13013","messageId":"10113","data":"13014","desc":"10209"},{"fix":"13015","messageId":"10113","data":"13016","desc":"10139"},{"fix":"13017","messageId":"10113","data":"13018","desc":"10139"},{"messageId":"10118","data":"13019","fix":"13020","desc":"13021"},{"messageId":"10118","data":"13022","fix":"13023","desc":"13024"},{"messageId":"10118","data":"13025","fix":"13026","desc":"13027"},{"messageId":"10118","data":"13028","fix":"13029","desc":"13030"},{"messageId":"10118","data":"13031","fix":"13032","desc":"13033"},{"messageId":"10131","fix":"13034","desc":"10133"},{"messageId":"10134","fix":"13035","desc":"10136"},{"fix":"13036","messageId":"10113","data":"13037","desc":"10209"},{"fix":"13038","messageId":"10113","data":"13039","desc":"10209"},{"messageId":"10131","fix":"13040","desc":"10133"},{"messageId":"10134","fix":"13041","desc":"10136"},{"messageId":"10131","fix":"13042","desc":"10133"},{"messageId":"10134","fix":"13043","desc":"10136"},{"messageId":"10131","fix":"13044","desc":"10133"},{"messageId":"10134","fix":"13045","desc":"10136"},{"messageId":"10131","fix":"13046","desc":"10133"},{"messageId":"10134","fix":"13047","desc":"10136"},{"messageId":"10131","fix":"13048","desc":"10133"},{"messageId":"10134","fix":"13049","desc":"10136"},{"messageId":"10131","fix":"13050","desc":"10133"},{"messageId":"10134","fix":"13051","desc":"10136"},{"messageId":"10131","fix":"13052","desc":"10133"},{"messageId":"10134","fix":"13053","desc":"10136"},{"messageId":"10131","fix":"13054","desc":"10133"},{"messageId":"10134","fix":"13055","desc":"10136"},{"messageId":"10131","fix":"13056","desc":"10133"},{"messageId":"10134","fix":"13057","desc":"10136"},[2309,2348],"`${context.userId?.substring(0, 8)  }...`",{"fix":"13058","messageId":"10113","data":"13059","desc":"10209"},{"fix":"13060","messageId":"10113","data":"13061",